---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site, retailers, u } from '../lib/site';
const first = 'Stoughton';
const cities = [...new Set(retailers.map((r) => r.city))].sort((a, b) => (a === first ? -1 : b === first ? 1 : a.localeCompare(b)));
const label: Record<string, string> = { draft: 'On draft', packaged: 'Bottles' };
const street = (r: { address: string; city: string }) => r.address.replace(new RegExp(`[,.]?\\s*${r.city}\\b.*$`, 'i'), '');
const maps = (r: { name: string; address: string }) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${r.name}, ${r.address}`)}`;
---
<Base title="Where to Find Mershon's Cider | Stores & Taps in Wisconsin" current="where-to-find" path="/where-to-find/"
  description={`Find Mershon's Cider on tap and in bottles at ${retailers.length} bars, liquor stores and grocers across Wisconsin, from Stoughton and Madison to Milwaukee and Door County.`}>
  <PageHero eyebrow="Stores & taps" title="Where to Find Mershon's Cider" image="photos/snowed-in-shelf.jpg" alt="Mershon's bottles lined up on a shelf" position="60% 50%"
    lead={`On draft and on shelves at ${retailers.length} spots across Wisconsin. Search by town or venue below.`} />

  <section class="py-14 md:py-20" data-finder>
    <div data-reveal-group class="container-x">
      <div class="card sticky top-[84px] z-20 grid gap-4 p-4 md:grid-cols-[1fr_auto] md:items-center md:p-5">
        <label class="relative block">
          <span class="sr-only">Search by town or venue</span>
          <Icon name="search" size={19} class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-honey" />
          <input type="search" data-finder-q placeholder="Search a town or store (e.g. Madison)" class="min-h-[48px] w-full rounded-[2px] border border-ink-3 bg-ink pl-12 pr-4 text-parchment placeholder:text-muted/80 focus:border-gold focus:outline-none" />
        </label>
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by type">
          {[['all', 'All'], ['draft', 'Draft Cider'], ['packaged', 'Packaged']].map(([k, l]) => (
            <button type="button" data-filter={k} aria-pressed={k === 'all' ? 'true' : 'false'} class="min-h-[44px] rounded-full border border-ink-3 px-4 font-slab text-sm font-semibold text-peach aria-pressed:border-gold aria-pressed:bg-gold aria-pressed:text-ink">{l}</button>
          ))}
          <span class="ml-1 text-sm text-muted" data-finder-count aria-live="polite">{retailers.length} locations</span>
        </div>
      </div>

      <div data-reveal-group class="mt-10 columns-1 gap-8 md:columns-2 lg:columns-3">
        {cities.map((c) => (
          <section data-city-group class="mb-8 break-inside-avoid">
            <h2 class="border-b border-ink-3 pb-2 text-3xl">{c}</h2>
            <ul>
              {retailers.filter((r) => r.city === c).sort((a, b) => a.name.localeCompare(b.name)).map((r) => (
                <li data-place data-type={r.type || 'other'} data-search={`${r.name} ${r.address} ${r.city}`.toLowerCase()} class="flex items-start justify-between gap-3 border-b border-ink-3/70 py-3">
                  <div>
                    <p class="font-slab font-semibold text-parchment">{r.name}</p>
                    <p class="text-sm text-muted">{street(r)}</p>
                  </div>
                  <div class="flex shrink-0 flex-col items-end gap-1">
                    {r.type && <span class={`rounded-full px-2.5 py-0.5 font-slab text-[.7rem] font-semibold uppercase tracking-wider ${r.type === 'draft' ? 'bg-amber text-ink' : 'border border-honey/50 text-peach'}`}>{label[r.type]}</span>}
                    <a href={maps(r)} target="_blank" rel="noopener" class="text-sm">Map<span class="sr-only"> for {r.name}, {r.address} (opens in new tab)</span></a>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <p data-finder-empty hidden class="card p-8 text-center text-lg">No matches. Try another town, or <a href={u('/contact/')}>ask us</a> where to find Mershon's near you.</p>
    </div>
  </section>

  <section class="border-t border-ink-3 bg-ink-2 py-14">
    <div data-reveal-group class="container-x flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div><h2 class="text-4xl">Not near a store?</h2><p class="mt-2 text-muted">Order online and we'll ship it to your door, or come see us in Stoughton.</p></div>
      <div class="flex flex-wrap gap-3"><a href={u('/order-cider/')} class="btn btn-gold">Order cider</a><a href={u('/tasting-room/')} class="btn btn-line">Visit the tasting room</a></div>
    </div>
  </section>
</Base>
