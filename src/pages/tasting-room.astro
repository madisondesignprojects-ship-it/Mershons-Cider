---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import HoursTable from '../components/HoursTable.astro';
import OpenBadge from '../components/OpenBadge.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { site, u } from '../lib/site';
const gallery = [
  { src: 'photos/taproom-aerial.jpg', alt: 'Overhead view of the tasting room bar and seating' },
  { src: 'photos/flight-shelf.jpg', alt: 'A tasting flight of five ciders in front of the bottle shelf' },
  { src: 'photos/taps.jpg', alt: 'Row of draft taps behind the bar' },
  { src: 'photos/snowed-in-shelf.jpg', alt: 'Mershon\'s bottles on the retail shelf' },
  { src: 'photos/taproom-hall.jpg', alt: 'The long taproom with tables and arcade games' },
  { src: 'photos/chalkboard.jpg', alt: 'Chalkboard listing Mershon\'s ciders' },
];
---
<Base title="Tasting Room & Bar | Mershon's Cidery, Stoughton WI" current="tasting-room" path="/tasting-room/" og="/og/tasting-room.jpg"
  description="Visit the Mershon's Cidery taproom and bar at 124 W Main St, Stoughton: draft cider, tasting flights, house cocktails and beer, plus bottles to go. Open Wednesday to Sunday.">
  <PageHero eyebrow="Visit our cidery taproom and bar" title="Tasting Room & Bar" image="photos/flight-board.jpg" alt="A flight of Mershon's ciders on a wooden paddle" position="50% 60%"
    lead="Draft cider, tasting flights, house cocktails & beer, right on Main Street in downtown Stoughton.">
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={site.directions} target="_blank" rel="noopener" class="btn btn-gold"><Icon name="nav" size={17} />Get directions<span class="sr-only"> (opens in new tab)</span></a>
      <a href={`tel:${site.tel}`} class="btn btn-line"><Icon name="phone" size={17} />{site.phone}</a>
    </div>
  </PageHero>

  <section class="py-16 md:py-24">
    <div class="container-x grid gap-12 lg:grid-cols-[1.15fr_1fr] lg:gap-20">
      <div>
        <p class="eyebrow mb-3">What's pouring</p>
        <h2 class="text-5xl">At the bar</h2>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {[
            { t: 'Draft Cider', d: 'Mershon\'s signature ciders, poured fresh from the tap.' },
            { t: 'Tasting Flights', d: 'Can\'t decide? Sample the lineup side by side.' },
            { t: 'House Cocktails', d: 'Mixed in-house at the bar.' },
            { t: 'Beer', d: 'For the friend who isn\'t a cider drinker (yet).' },
          ].map((x) => (
            <li class="card p-6"><h3 class="text-[1.7rem]">{x.t}</h3><p class="mt-1 text-muted">{x.d}</p></li>
          ))}
        </ul>
        <div class="card mt-4 flex items-center gap-5 p-6">
          <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gold text-ink"><Icon name="store" size={22} /></span>
          <div><h3 class="text-[1.7rem]">Cider bottled to go</h3><p class="text-muted">750ml and 12oz bottles. Or <a href={u('/order-cider/')}>order online</a> and have it shipped.</p></div>
        </div>
      </div>
      <aside class="card self-start p-6 md:p-8" aria-labelledby="hrs">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 id="hrs" class="text-4xl">Hours</h2>
          <OpenBadge class="font-slab text-sm font-semibold text-peach" />
        </div>
        <HoursTable class="mt-5" />
        <div class="mt-6 border-t border-ink-3 pt-6">
          <p class="font-slab font-semibold text-peach">{site.name}</p>
          <address class="not-italic text-parchment">{site.street}<br />{site.city}, {site.state} {site.zip}</address>
        </div>
      </aside>
    </div>
  </section>

  <section class="pb-20 md:pb-28" aria-labelledby="inside">
    <div class="container-x">
      <p class="eyebrow mb-3">Inside the cidery</p>
      <h2 id="inside" class="text-5xl">Take a look around</h2>
      <ul class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
        {gallery.map((g, i) => (
          <li class={`overflow-hidden rounded-[3px] ${i === 0 ? 'col-span-2 row-span-2 md:col-span-2' : ''}`}>
            <Img src={g.src} alt={g.alt} sizes={i === 0 ? '(min-width:768px) 66vw, 100vw' : '(min-width:768px) 33vw, 50vw'} class="h-full min-h-[160px] w-full object-cover transition-transform duration-700 hover:scale-[1.03]" pictureClass="block h-full" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-t border-ink-3 bg-ink-2 py-16 md:py-20" aria-labelledby="find">
    <div class="container-x grid items-center gap-10 lg:grid-cols-2">
      <div>
        <h2 id="find" class="text-5xl">Find us on Main Street</h2>
        <p class="mt-4 text-lg">{site.street}, {site.city}, {site.state} {site.zip}</p>
        <p class="mt-6 text-muted">Planning a party? The taproom is available for <a href={u('/private-events/')}>private events</a>.</p>
      </div>
      <MapEmbed />
    </div>
  </section>
</Base>
