---
import '@fontsource/lobster-two/400.css';
import '@fontsource/lobster-two/700.css';
import '@fontsource/bitter/600.css';
import '@fontsource-variable/source-sans-3/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import SEO from '../components/SEO.astro';
import Schema from '../components/Schema.astro';
import lobster700 from '@fontsource/lobster-two/files/lobster-two-latin-700-normal.woff2?url';
import sans from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
interface Props { title: string; description: string; path: string; current: string; og?: string; noindex?: boolean }
const { title, description, path, current, og, noindex } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0C0909" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={lobster700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      // Enable reveal styles only when JS runs; failsafe shows everything if the module never boots.
      document.documentElement.classList.add('js');
      setTimeout(function () { if (!window.__revealReady) document.documentElement.classList.add('reveal-off'); }, 3500);
      // Record whether this page arrived via a cross-document view transition (used by QA).
      window.addEventListener('pagereveal', function (e) { window.__vt = !!e.viewTransition; });
    </script>
    <SEO title={title} description={description} path={path} og={og} noindex={noindex} />
    <Schema />
  </head>
  <body class="min-h-screen pb-[calc(60px+env(safe-area-inset-bottom))] md:pb-0">
    <a href="#main" class="sr-only z-[70] bg-gold px-5 py-3 font-semibold text-ink focus:not-sr-only focus:fixed focus:left-3 focus:top-3">Skip to main content</a>
    <Header current={current} />
    <main id="main" tabindex="-1" class="focus:outline-none"><slot /></main>
    <Footer />
    <StickyBar />
    <script>import '../scripts/site.ts'; import '../scripts/reveal.ts'; (window as any).__revealReady = true;</script>
  </body>
</html>
