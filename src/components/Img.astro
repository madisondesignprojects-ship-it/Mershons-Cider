---
import { Picture } from 'astro:assets';
import { img, widthsFor } from '../lib/images';
interface Props { src: string; alt: string; sizes?: string; class?: string; pictureClass?: string; eager?: boolean; widths?: number[]; style?: string }
const { src, alt, sizes = '(min-width:1024px) 50vw, 100vw', class: cls = '', pictureClass = '', eager = false, widths, style } = Astro.props;
const meta = img(src);
---
<Picture src={meta} alt={alt} formats={['avif', 'webp']} fallbackFormat={meta.format === 'png' ? 'png' : 'jpg'} widths={widthsFor(meta, widths)} sizes={sizes}
  class={cls} style={style} pictureAttributes={{ class: pictureClass }} loading={eager ? 'eager' : 'lazy'} decoding={eager ? 'auto' : 'async'}
  fetchpriority={eager ? 'high' : undefined} />
